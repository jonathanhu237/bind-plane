:8080 {
	header Referrer-Policy "no-referrer"

	# The image serves the app under BIND_PLANE_BASE_PATH (/ by default); any
	# other path leads into it.
	@outside not path {$BIND_PLANE_BASE_PATH:/}*
	redir @outside {$BIND_PLANE_BASE_PATH:/}

	handle_path {$BIND_PLANE_BASE_PATH:/}* {
		@api path /api /api/*
		handle @api {
			reverse_proxy api:8080
		}

		# Only build files: the /assets page itself is an SPA route.
		@assets path /assets/*
		handle @assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * /srv
			try_files {path} /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}
