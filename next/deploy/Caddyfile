{
	admin off
	# The certificate comes from Caddy's own CA; never touch the host trust store,
	# and never listen on port 80 (another service owns it on shared hosts).
	skip_install_trust
	auto_https disable_redirects
	# Browsers send no SNI to an IP address, and behind Docker's port mapping the
	# local address is the container's, so name the certificate to serve.
	default_sni {$BIND_PLANE_TLS_HOST}
}

# BIND_PLANE_SITE is APP_PUBLIC_URL, for example https://222.200.161.40:8443.
# Replace `tls internal` with a real certificate before adding HSTS.
{$BIND_PLANE_SITE} {
	tls internal
	encode zstd gzip
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}
	# Only build files: the /assets page itself is an SPA route.
	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
