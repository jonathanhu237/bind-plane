{
	admin off
	# An https:// site gets its certificate from Caddy's own CA; an http:// site
	# needs none. Never touch the host trust store, and never listen on port 80
	# (another service owns it on shared hosts).
	local_certs
	skip_install_trust
	auto_https disable_redirects
	# Browsers send no SNI to an IP address, and behind Docker's port mapping the
	# local address is the container's, so name the certificate to serve.
	default_sni {$BIND_PLANE_TLS_HOST:localhost}
	servers {
		# Behind a shared proxy, the peers whose X-Forwarded-For is kept, so the
		# API sees the browser's address rather than the proxy's.
		trusted_proxies static {$BIND_PLANE_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# BIND_PLANE_SITE is where Caddy listens: APP_PUBLIC_URL without its path, for
# example http://222.200.161.40:8080 or https://222.200.161.40:8443, or
# http://:18404 behind a shared proxy. For a real certificate add a tls
# directive here, then HSTS.
{$BIND_PLANE_SITE} {
	encode zstd gzip
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
	# The admin image serves the app under the base path it was built with
	# (BIND_PLANE_BASE_PATH, / by default); any other path leads into it.
	@outside not path {$BIND_PLANE_BASE_PATH:/}*
	redir @outside {$BIND_PLANE_BASE_PATH:/}

	handle_path {$BIND_PLANE_BASE_PATH:/}* {
		@api path /api /api/*
		handle @api {
			reverse_proxy api:8080
		}
		# Only build files: the /assets page itself is an SPA route.
		@assets path /assets/*
		handle @assets {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			root * /srv
			try_files {path} /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}
