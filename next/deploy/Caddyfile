{
	admin off
	# An https:// site gets its certificate from Caddy's own CA; an http:// site
	# needs none. Never touch the host trust store, and never listen on port 80
	# (another service owns it on shared hosts).
	local_certs
	skip_install_trust
	auto_https disable_redirects
	# Browsers send no SNI to an IP address, and behind Docker's port mapping the
	# local address is the container's, so name the certificate to serve.
	default_sni {$BIND_PLANE_TLS_HOST}
}

# BIND_PLANE_SITE is APP_PUBLIC_URL, for example http://222.200.161.40:8080 or
# https://222.200.161.40:8443. For a real certificate add a tls directive here,
# then HSTS.
{$BIND_PLANE_SITE} {
	encode zstd gzip
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}
	# Only build files: the /assets page itself is an SPA route.
	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
