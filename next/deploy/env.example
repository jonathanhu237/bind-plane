# Copy to .env next to compose.yaml, fill every empty value, then `chmod 600 .env`.
# Generate each key separately (never reuse one value):
#   python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b"=").decode())'
BIND_PLANE_TAG=
# The exact origin people type into the browser; Caddy serves its certificate for it.
APP_PUBLIC_URL=https://222.200.161.40:8443
# The host part of APP_PUBLIC_URL (an IP address or name).
BIND_PLANE_TLS_HOST=222.200.161.40
BIND_PLANE_HTTPS_PORT=8443
BIND_PLANE_LISTEN=0.0.0.0
# Private network for the stack; must not overlap the switches' management networks.
BIND_PLANE_SUBNET=172.31.240.0/24
BIND_PLANE_TIMEZONE=Asia/Shanghai
# Parallel device operations (backups, reachability checks) in the worker.
BIND_PLANE_DEVICE_CONCURRENCY=8

POSTGRES_PASSWORD=
PASSWORD_RESET_TOKEN_KEY=
INVITATION_TOKEN_KEY=
EMAIL_SETTINGS_ENCRYPTION_KEY=
# Seals switch credentials and configuration backups. Losing it makes both unreadable.
BIND_PLANE_CREDENTIAL_ENCRYPTION_KEY=
